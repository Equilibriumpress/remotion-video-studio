{
  "id": "studio-product-showcase",
  "title": "Remotion Video Studio · Product Explainer",
  "template": "explainer",
  "format": "vertical",
  "fps": 30,
  "theme": {
    "background": "#0A0C10",
    "foreground": "#F7F8FA",
    "muted": "#AAB4C0",
    "accent": "#78E08F"
  },
  "scenes": [
    {
      "id": "p-launch",
      "type": "launch-hero",
      "duration": 3.2,
      "eyebrow": "Remotion Video Studio",
      "title": "Prompt to MP4",
      "subtitle": "A browser-first video system built from reusable motion components.",
      "badge": "Render locally",
      "transition": "fade"
    },
    {
      "id": "p-features",
      "type": "feature-grid",
      "duration": 5,
      "title": "One system, many video modes",
      "items": [
        {
          "title": "SVG Motion",
          "body": "Browser-safe graphics",
          "icon": "spark"
        },
        {
          "title": "Travel Routes",
          "body": "Maps without tiles",
          "icon": "route"
        },
        {
          "title": "Data Stories",
          "body": "Animated charts",
          "icon": "chart"
        },
        {
          "title": "Video & Audio",
          "body": "Remotion media",
          "icon": "play"
        }
      ],
      "transition": "slide-up"
    },
    {
      "id": "p-workflow",
      "type": "timeline",
      "duration": 4,
      "title": "One lightweight workflow",
      "items": [
        {
          "label": "ChatGPT",
          "value": "project JSON"
        },
        {
          "label": "GitHub",
          "value": "source"
        },
        {
          "label": "Pages",
          "value": "preview"
        },
        {
          "label": "Browser",
          "value": "MP4"
        }
      ],
      "transition": "fade"
    },
    {
      "id": "p-callout",
      "type": "callout",
      "duration": 3.2,
      "value": "0 min",
      "title": "Video rendering in Actions",
      "body": "GitHub builds the static studio. The final video render runs on the user's device.",
      "transition": "zoom"
    },
    {
      "id": "p-build",
      "type": "comparison",
      "duration": 3.8,
      "title": "Observed Pages build improvement",
      "left": {
        "label": "Vite 7",
        "value": ">5 min"
      },
      "right": {
        "label": "Vite 8",
        "value": "~4 sec"
      },
      "motion": "pop",
      "transition": "wipe"
    },
    {
      "id": "p-cta",
      "type": "cta",
      "duration": 3,
      "title": "Build the system once.",
      "subtitle": "Then make the next video from data.",
      "action": "Render in browser",
      "transition": "fade"
    }
  ]
}
