{
  "id": "utrecht-data-showcase",
  "title": "Utrecht Data Story · Demo Dataset",
  "template": "data-story",
  "format": "vertical",
  "fps": 30,
  "theme": {
    "background": "#071419",
    "foreground": "#F1F7F8",
    "muted": "#91A8AF",
    "accent": "#56D4C5"
  },
  "scenes": [
    {
      "id": "u-chapter",
      "type": "chapter-number",
      "duration": 2.4,
      "number": "01",
      "title": "Utrecht housing signal",
      "subtitle": "Synthetic demo data for the motion system",
      "transition": "fade"
    },
    {
      "id": "u-location",
      "type": "location-card",
      "duration": 3.1,
      "title": "A city-level data story",
      "subtitle": "SVG only",
      "location": "Utrecht",
      "region": "Netherlands · demo context",
      "x": 0.52,
      "y": 0.48,
      "transition": "slide-left"
    },
    {
      "id": "u-kinetic",
      "type": "kinetic-title",
      "duration": 2.7,
      "text": "Read the change not just the number",
      "kicker": "DEMO DATA",
      "style": "oversize",
      "align": "center",
      "transition": "fade"
    },
    {
      "id": "u-donut",
      "type": "donut-chart",
      "duration": 3.6,
      "title": "Illustrative target progress",
      "value": 68,
      "label": "sample completion rate",
      "suffix": "%",
      "transition": "zoom"
    },
    {
      "id": "u-bar-line",
      "type": "bar-line-chart",
      "duration": 5,
      "title": "Two signals, one story",
      "items": [
        {
          "label": "Q1",
          "bar": 42,
          "line": 35
        },
        {
          "label": "Q2",
          "bar": 49,
          "line": 46
        },
        {
          "label": "Q3",
          "bar": 61,
          "line": 59
        },
        {
          "label": "Q4",
          "bar": 68,
          "line": 74
        }
      ],
      "barLabel": "Illustrative completion",
      "lineLabel": "Illustrative demand index",
      "barSuffix": "%",
      "lineSuffix": "",
      "transition": "slide-up"
    },
    {
      "id": "u-callout",
      "type": "callout",
      "duration": 3.2,
      "value": "+26 pts",
      "title": "The story is the movement",
      "body": "These values are synthetic. The scene demonstrates how the studio turns a small dataset into motion.",
      "transition": "fade"
    },
    {
      "id": "u-compare",
      "type": "comparison",
      "duration": 3.6,
      "title": "Two views of the same demo",
      "left": {
        "label": "Start",
        "value": "42%"
      },
      "right": {
        "label": "End",
        "value": "68%"
      },
      "motion": "pop",
      "transition": "wipe"
    },
    {
      "id": "u-end",
      "type": "outro",
      "duration": 2.5,
      "title": "Data becomes narrative",
      "subtitle": "SVG charts · type · motion",
      "motion": "fade-rise",
      "transition": "fade"
    }
  ]
}
